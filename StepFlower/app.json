{
  "expo": {
    "name": "StepFlower",
    "slug": "StepFlower",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "stepflower",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.froggotkd.StepFlower"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f2e7e5",
          "dark": {
            "backgroundColor": "#f2e7e5"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/font8bit.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "font8bit",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/font8bit.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/font8bit.ttf"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd230976-bed7-4130-aa72-0df792a45328"
      }
    }
  }
}
